DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rag_report?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google SSO identities allowed to request ADMIN promotions.
# These identities bootstrap the initial ADMIN access and act as platform owners.
PLATFORM_OWNER_EMAILS=""

# Optional ISO-8601 timestamp supplied by your backup job after its latest successful run.
DATABASE_LAST_BACKUP_AT=""
DATABASE_BACKUP_PROVIDER=""

# Required for AI writing and revision. Create a free OpenRouter API key.
# Preferred variables (LLM_*) work with hosted HTTPS OpenAI-compatible endpoints and take
# precedence over the legacy OPENAI_* fallbacks below.
# Hosted OpenAI-compatible chat-completions endpoints:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1      (openrouter/free router)
#   TokenRouter: https://api.tokenrouter.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=""
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_REPORT_MODEL="openrouter/free"
# Optional second and third hosted endpoints. Calls rotate through configured
# endpoints; an HTTP error tries the next one. OpenRouter keys on the same
# account share its free quota. Set all three values per endpoint or leave blank.
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_BASE_URL=""
LLM_FALLBACK_MODEL=""
LLM_FALLBACK_2_API_KEY=""
LLM_FALLBACK_2_BASE_URL=""
LLM_FALLBACK_2_MODEL=""
# Maximum model call duration in milliseconds (long sections need 10-15 min).
LLM_TIMEOUT_MS="600000"
# USD price per 1M input/output tokens, used to persist generation cost.
LLM_INPUT_COST_PER_M="0"
LLM_OUTPUT_COST_PER_M="0"
# Long-form report targets (~50-page PFE pipeline: outline pass + section loop).
REPORT_TARGET_PAGES="50"

# Legacy fallback variables (used only when LLM_* is not set).
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
# Model used for summaries and reports.
OPENAI_REPORT_MODEL=""
# JSON behavior: "schema" (strict json_schema, official OpenAI), "object"
# (json_object + prompt contract, recommended for compatible providers), "off".
# Auto by default: schema on api.openai.com and OpenRouter, object otherwise.
OPENAI_JSON_MODE=""
# Maximum model call duration in milliseconds.
OPENAI_TIMEOUT_MS="120000"

# Detailed AI request records are aggregated monthly, then removed after this many days (90-180).
AI_USAGE_RETENTION_DAYS="180"
# Secret bearer token used by the scheduled GET /api/cron/usage-retention task.
RETENTION_CRON_SECRET="replace-with-a-long-random-secret"

# Local development only. Never enable this in production.
AUTH_ALLOW_DEMO="false"
NEXT_PUBLIC_AUTH_ALLOW_DEMO="false"

# Stripe billing (test or live). Without STRIPE_SECRET_KEY, the checkout/portal
# endpoints return 503 and the plan simulator is the only way to switch tiers.
# Create prices at https://dashboard.stripe.com/prices and copy their price IDs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_ID=""
STRIPE_PRICE_PRO_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
