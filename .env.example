DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rag_report?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google SSO identities allowed to request ADMIN promotions.
# These identities bootstrap the initial ADMIN access and act as platform owners.
PLATFORM_OWNER_EMAILS=""

# Optional ISO-8601 timestamp supplied by your backup job after its latest successful run.
DATABASE_LAST_BACKUP_AT=""
DATABASE_BACKUP_PROVIDER=""

# Optional. Without a key, generation uses the local preview generator.
# Any OpenAI-compatible chat-completions endpoint works:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1      (":free" models available)
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:      http://localhost:11434/v1         (100% local and free, any key)
OPENAI_API_KEY=""
OPENAI_BASE_URL="http://localhost:11434/v1"
# Model used for summaries and reports.
OPENAI_REPORT_MODEL="qwen2.5:1.5b"
# JSON behavior: "schema" (strict json_schema, official OpenAI), "object"
# (json_object + prompt contract, recommended for compatible providers), "off".
# Auto by default: schema on api.openai.com, object otherwise.
OPENAI_JSON_MODE=""
# Maximum model call duration in milliseconds.
OPENAI_TIMEOUT_MS="120000"

# Detailed AI request records are aggregated monthly, then removed after this many days (90-180).
AI_USAGE_RETENTION_DAYS="180"
# Secret bearer token used by the scheduled GET /api/cron/usage-retention task.
RETENTION_CRON_SECRET="replace-with-a-long-random-secret"

# Local development only. Never enable this in production.
AUTH_ALLOW_DEMO="false"
NEXT_PUBLIC_AUTH_ALLOW_DEMO="false"

# Stripe billing (test or live). Without STRIPE_SECRET_KEY, the checkout/portal
# endpoints return 503 and the plan simulator is the only way to switch tiers.
# Create prices at https://dashboard.stripe.com/prices and copy their price IDs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_ID=""
STRIPE_PRICE_PRO_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
