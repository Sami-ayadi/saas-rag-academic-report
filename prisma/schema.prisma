generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMERATIONS ====================

enum Tier {
  FREE
  STARTER
  PRO
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  SUMMARIZING
  SUMMARY_READY
  GENERATING
  REPORT_READY
  EXPORTED
}

enum IntakeStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum RoleChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==================== TABLES ====================

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  emailVerified    DateTime?
  name             String?
  birthDate        DateTime?
  gender           String?
  image            String?
  tier             Tier      @default(FREE)
  role             Role      @default(USER)
  isActive         Boolean   @default(true)
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  creditsUsed      Int       @default(0)
  creditsLimit     Int       @default(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projects       Project[]
  jobs           GenerationJob[]
  accounts       Account[]
  sessions       Session[]
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  notifications  Notification[]
  quotaUsage     EntitlementUsage[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  linkView  String?
  metadata  Json     @default("{}")
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AdminAuditLog {
  id          String        @id @default(cuid())
  actorId     String?
  action      String
  severity    AuditSeverity @default(INFO)
  targetType  String
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetId])
}

model RoleChangeRequest {
  id            String           @id @default(cuid())
  targetUserId  String
  requestedById String
  currentRole   Role
  requestedRole Role
  status        RoleChangeStatus @default(PENDING)
  reason        String?
  reviewedById  String?
  reviewReason  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([requestedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  title         String
  brief         String?
  academicLevel String        @default("Master")
  university    String?
  field         String?
  status        ProjectStatus @default(DRAFT)
  language      String        @default("fr")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  summaries Summary[]
  reports   Report[]
  jobs      GenerationJob[]
  intake    ProjectIntake?
  briefs    ProjectBrief[]

  @@index([userId])
}

model ProjectIntake {
  id            String       @id @default(cuid())
  projectId     String       @unique
  schemaVersion Int          @default(1)
  currentStep   Int          @default(1)
  status        IntakeStatus @default(IN_PROGRESS)
  answers       Json         @default("{}")
  riskFlags     Json         @default("[]")
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  briefs  ProjectBrief[]
}

model ProjectBrief {
  id        String   @id @default(cuid())
  projectId String
  intakeId  String
  version   Int      @default(1)
  content   Json
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intake  ProjectIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([intakeId])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  status       String   @default("uploaded")
  chunkCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Summary {
  id        String        @id @default(cuid())
  projectId String
  version   Int           @default(1)
  content   String        @default("")
  structure String        @default("[]")
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([projectId])
}

model Report {
  id        String        @id @default(cuid())
  projectId String
  summaryId String?
  title     String
  content   String        @default("")
  sections  String        @default("[]")
  /// Protected table of contents. Only served to tiers with the tableOfContents entitlement.
  outline   String        @default("[]")
  status    ProjectStatus @default(DRAFT)
  wordCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary Summary? @relation(fields: [summaryId], references: [id])

  @@index([projectId])
}

model GenerationJob {
  id              String    @id @default(cuid())
  userId          String
  projectId       String
  type            String    @default("report")
  status          JobStatus @default(PENDING)
  progress        Int       @default(0)
  progressMessage String    @default("")
  outputData      String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model Embedding {
  id         String   @id @default(cuid())
  projectId  String
  documentId String?
  chunkIndex Int      @default(0)
  content    String
  embedding  String   @default("")
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([documentId])
}

/// Monthly, per-kind quota counters consumed atomically by the entitlement module.
model EntitlementUsage {
  id        String   @id @default(cuid())
  userId    String
  /// UTC calendar month, formatted as YYYY-MM.
  period    String
  /// "generation" or "regeneration".
  kind      String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, kind])
  @@index([userId, period])
}

/// Stripe webhook event IDs already processed (idempotency guard): Stripe
/// redelivers events, and each delivery must be applied at most once.
model ProcessedWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model ApiUsage {
  id                String    @id @default(cuid())
  userId            String
  projectId         String?
  type              String
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  costUsd           Float     @default(0)
  retentionExempt   Boolean   @default(false)
  retentionReason   String?
  retentionMarkedAt DateTime?
  retentionMarkedBy String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([retentionExempt, createdAt])
}

model ApiUsageMonthly {
  month            DateTime
  userId           String
  type             String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  costUsd          Float    @default(0)
  requestCount     Int      @default(0)
  lastAggregatedAt DateTime @updatedAt

  @@id([month, userId, type])
  @@index([month])
  @@index([userId])
}
