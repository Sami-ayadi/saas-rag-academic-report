generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMERATIONS ====================

enum Tier {
  FREE
  STARTER
  PRO
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  NEEDS_INPUT
  COMPLETED
  FAILED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  SOURCES_READY
  BRIEF_APPROVED
  OUTLINE_APPROVED
  DRAFTING
  REVIEW_REQUIRED
  APPROVED
  SUMMARIZING
  SUMMARY_READY
  GENERATING
  REPORT_READY
  EXPORTED
}

enum ReportPlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum QuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum IntakeStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum RoleChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==================== TABLES ====================

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  emailVerified    DateTime?
  name             String?
  birthDate        DateTime?
  gender           String?
  image            String?
  university       String?
  tier             Tier      @default(FREE)
  role             Role      @default(USER)
  isActive         Boolean   @default(true)
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  creditsUsed      Int       @default(0)
  creditsLimit     Int       @default(3)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projects          Project[]
  jobs              GenerationJob[]
  accounts          Account[]
  sessions          Session[]
  adminAuditLogs    AdminAuditLog[]    @relation("AdminAuditActor")
  notifications     Notification[]
  quotaUsage        EntitlementUsage[]
  quotaReservations QuotaReservation[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  linkView  String?
  metadata  Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AdminAuditLog {
  id          String        @id @default(cuid())
  actorId     String?
  action      String
  severity    AuditSeverity @default(INFO)
  targetType  String
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetId])
}

model RoleChangeRequest {
  id            String           @id @default(cuid())
  targetUserId  String
  requestedById String
  currentRole   Role
  requestedRole Role
  status        RoleChangeStatus @default(PENDING)
  reason        String?
  reviewedById  String?
  reviewReason  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([requestedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  title         String
  brief         String?
  academicLevel String        @default("Master")
  university    String?
  field         String?
  status        ProjectStatus @default(DRAFT)
  language      String        @default("fr")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  summaries   Summary[]
  reports     Report[]
  jobs        GenerationJob[]
  intake      ProjectIntake?
  briefs      ProjectBrief[]
  reportPlans ReportPlan[]

  @@index([userId])
}

model ProjectIntake {
  id            String       @id @default(cuid())
  projectId     String       @unique
  schemaVersion Int          @default(1)
  currentStep   Int          @default(1)
  status        IntakeStatus @default(IN_PROGRESS)
  answers       Json         @default("{}")
  riskFlags     Json         @default("[]")
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  briefs  ProjectBrief[]
}

model ProjectBrief {
  id        String   @id @default(cuid())
  projectId String
  intakeId  String
  version   Int      @default(1)
  content   Json
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intake      ProjectIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  reportPlans ReportPlan[]

  @@unique([projectId, version])
  @@index([intakeId])
}

model Document {
  id              String    @id @default(cuid())
  projectId       String
  filename        String
  originalName    String
  mimeType        String
  size            Int
  storageKey      String
  status          String    @default("uploaded")
  role            String    @default("PROJECT_EVIDENCE")
  chunkCount      Int       @default(0)
  pageCount       Int?
  contentHash     String?
  extractionError String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  Embedding[]

  @@index([projectId])
}

model ReportPlan {
  id          String           @id @default(cuid())
  projectId   String
  briefId     String
  version     Int              @default(1)
  templateKey String           @default("software-classic-v1")
  content     Json
  status      ReportPlanStatus @default(DRAFT)
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brief   ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([projectId, version])
  @@index([briefId])
  @@index([projectId, status])
}

model Summary {
  id        String        @id @default(cuid())
  projectId String
  version   Int           @default(1)
  content   String        @default("")
  structure String        @default("[]")
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([projectId])
}

model Report {
  id            String        @id @default(cuid())
  projectId     String
  summaryId     String?
  planId        String?
  title         String
  content       String        @default("")
  sections      String        @default("[]")
  /// Protected table of contents. Only served to tiers with the tableOfContents entitlement.
  outline       String        @default("[]")
  status        ProjectStatus @default(DRAFT)
  wordCount     Int           @default(0)
  qualityIssues Json          @default("[]")
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary Summary?         @relation(fields: [summaryId], references: [id])
  plan    ReportPlan?      @relation(fields: [planId], references: [id])
  exports ExportArtifact[]

  @@index([projectId])
}

model GenerationJob {
  id              String    @id @default(cuid())
  userId          String
  projectId       String
  idempotencyKey  String?
  contextHash     String?
  type            String    @default("report")
  status          JobStatus @default(PENDING)
  progress        Int       @default(0)
  progressMessage String    @default("")
  outputData      String?
  errorMessage    String?
  attempt         Int       @default(0)
  maxAttempts     Int       @default(5)
  lockedBy        String?
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?
  nextAttemptAt   DateTime?
  quotaPeriod     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([projectId])
  @@index([status, nextAttemptAt, createdAt])
}

model Embedding {
  id         String   @id @default(cuid())
  projectId  String
  documentId String?
  chunkIndex Int      @default(0)
  pageNumber Int?
  locator    String?
  content    String
  embedding  String   @default("")
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
  @@index([projectId, documentId, chunkIndex])
}

model ExportArtifact {
  id          String   @id @default(cuid())
  reportId    String
  format      String
  storageKey  String
  contentHash String
  createdAt   DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

/// Monthly, per-kind quota counters consumed atomically by the entitlement module.
model EntitlementUsage {
  id        String   @id @default(cuid())
  userId    String
  /// UTC calendar month, formatted as YYYY-MM.
  period    String
  /// "generation" or "regeneration".
  kind      String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, kind])
  @@index([userId, period])
}

model QuotaReservation {
  id           String                 @id @default(cuid())
  operationKey String                 @unique
  userId       String
  period       String
  kind         String
  status       QuotaReservationStatus @default(RESERVED)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period, kind])
}

/// Stripe webhook event IDs already processed (idempotency guard): Stripe
/// redelivers events, and each delivery must be applied at most once.
model ProcessedWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model ApiUsage {
  id                String    @id @default(cuid())
  userId            String
  projectId         String?
  type              String
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  costUsd           Float     @default(0)
  retentionExempt   Boolean   @default(false)
  retentionReason   String?
  retentionMarkedAt DateTime?
  retentionMarkedBy String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([retentionExempt, createdAt])
}

model ApiUsageMonthly {
  month            DateTime
  userId           String
  type             String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  costUsd          Float    @default(0)
  requestCount     Int      @default(0)
  lastAggregatedAt DateTime @updatedAt

  @@id([month, userId, type])
  @@index([month])
  @@index([userId])
}
